[Unit]
Description=Domains and DNS Security Monitor
After=network-online.target

[Container]
# Replace with your actual GitHub username and repository name
Image=ghcr.io/your-github-username/your-repo-name@sha256:REPLACE_WITH_RELEASE_DIGEST

# Add your auth tokens using Secrets here to avoid hardcoding them in config.json
# Create them using: podman secret create <secret-name> <file-with-secret>
# Secret=ntfy-auth,type=env,target=NTFY_AUTH
# Secret=telegram-token,type=env,target=TELEGRAM_TOKEN
# Environment=TELEGRAM_CHAT_ID=your_telegram_chat_id

# Use the immutable digest published for the reviewed release. Upgrade only by
# replacing this digest after reviewing release notes and configuration changes.

# Tell the Go app where to find configuration
Environment=CONFIG_PATH=/app/config.json

# Expose the HTTP port for JSON State (/api/state) and Web Dashboard (/)
# Ensure this matches the port defined in your config.json
PublishPort=8080:8080

# Mount your configuration file into the container as read-only
Volume=/path/to/your/homelab/config.json:/app/config.json:ro

# Optional: mount custom email provider definitions read-only
# Volume=/path/to/your/homelab/email_providers:/app/data/email_providers:ro

[Service]
# Automatically restart the container if it crashes or the system reboots
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
