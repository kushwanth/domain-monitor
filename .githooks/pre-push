#!/bin/sh
set -u

warn() {
	echo "pre-push advisory: $*" >&2
}

if command -v go >/dev/null 2>&1 && command -v gofmt >/dev/null 2>&1; then
	unformatted=$(gofmt -l src 2>/dev/null || true)
	if [ -n "$unformatted" ]; then
		warn "Go source is not formatted:"
		echo "$unformatted" >&2
	fi

	coverage_file=$(mktemp "${TMPDIR:-/tmp}/domain-monitor-coverage.XXXXXX")
	trap 'rm -f "$coverage_file"' EXIT HUP INT TERM
	if go test -race -covermode=atomic -coverprofile="$coverage_file" ./...; then
		coverage=$(go tool cover -func="$coverage_file" 2>/dev/null | awk '/^total:/ {gsub(/%/, "", $3); print $3}')
		if [ -z "$coverage" ]; then
			warn "unable to determine total test coverage"
		elif ! awk -v coverage="$coverage" 'BEGIN { exit coverage >= 90 ? 0 : 1 }'; then
			warn "test coverage ${coverage}% is below the recommended 90%"
		fi
	else
		warn "tests failed"
	fi

	go vet ./... || warn "go vet reported issues"
else
	warn "Go toolchain unavailable; install with: pacman -S go"
fi

if command -v revive >/dev/null 2>&1; then
	revive ./... || warn "revive reported issues"
else
	warn "revive unavailable; install with: pacman -S revive"
fi

exit 0
